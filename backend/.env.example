# Copier vers .env puis adapter. Les montants sont en centimes de gourde (100 = 1 HTG).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://keno:keno@localhost:5432/keno

# Secrets : 32 caractères minimum, obligatoires en production (openssl rand -hex 32)
JWT_SECRET=
STAFF_JWT_SECRET=
AGENT_JWT_SECRET=
OTP_PEPPER=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Retraits au-dessus de ce montant : validation manuelle par la finance (10 000 HTG)
WITHDRAWAL_APPROVAL_THRESHOLD_CENTS=1000000

# Fournisseur de paiement factice (développement uniquement, refusé en production)
PAYMENTS_FAKE=true

# Code TOTP (6 chiffres) à la connexion du back-office et de la caisse : on (défaut) ou off.
# off sert au développement et aux démos ; refusé en production.
STAFF_TOTP=on


# HTTPS : redirection 308 de tout HTTP vers HTTPS + HSTS (actif par défaut en production, FORCE_HTTPS=false pour couper).
# Derrière un proxy qui termine le TLS (nginx, load balancer), mettre TRUST_PROXY=true pour lire X-Forwarded-Proto.
# FORCE_HTTPS=true

# API seule (par défaut) : le front est hébergé à part, son origine va dans CORS_ORIGINS.
# Pour servir aussi le front depuis l'API (démo, écrans TV sur http://localhost:3000/), indiquer le dossier contenant index.html :
# FRONT_DIR=..

# Adresse encodée dans le QR des tickets vendus au guichet (le code du ticket est ajouté à la fin)
TICKET_QR_BASE_URL=
