{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paryaj Paw Boutik",
  "version": "0.1.0",
  "identifier": "ht.paryajpaw.boutik",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Paryaj Paw Boutik",
        "width": 1366,
        "height": 820,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "Paryaj Paw",
    "category": "Business"
  }
}
